{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurant-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "minify": true,
  "routes": [
    { "pattern": "restaurant-mcp.odell.io", "custom_domain": true }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "aodell.cloudflareaccess.com"
  },
  "kv_namespaces": [
    { "binding": "CREDS", "id": "7d05dafe369446c29cdd0cd61bf6b60e" }
  ],
  // Worker version id and deploy time for get_server_info.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // Worker secrets (dashboard or `wrangler secret put`, never in this file):
  // ACCESS_AUD: the Audience (AUD) tag of the self-hosted Access application
  // Upstream login, unchanged: RESY_EMAIL, RESY_PASSWORD, optional RESY_AUTH_TOKEN
  "secrets": {
    "required": ["ACCESS_AUD"]
  }
}
